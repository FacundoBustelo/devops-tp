{
  "uid": "devops-api",
  "title": "API · Monitoreo y observabilidad",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "devops",
    "api"
  ],
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Solicitudes por segundo",
      "type": "stat",
      "description": "Scrape disponible y muestras suficientes: cero indica ausencia de tráfico.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "devops-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(devops_http_requests_total{job=\"laravel\"}[2m]))",
          "legendFormat": "Solicitudes por segundo",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sin datos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Tráfico por ruta y estado",
      "type": "timeseries",
      "description": "Etiquetas acotadas; no contiene parámetros.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "devops-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route,status)(rate(devops_http_requests_total{job=\"laravel\"}[2m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sin datos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Errores 4xx",
      "type": "timeseries",
      "description": "Errores del cliente.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "devops-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(devops_http_requests_total{job=\"laravel\",status=~\"4..\"}[2m]))",
          "legendFormat": "Errores 4xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sin datos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Errores 5xx",
      "type": "timeseries",
      "description": "Con up=1, estos errores son de API y no de recolección.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "devops-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(devops_http_requests_total{job=\"laravel\",status=~\"5..\"}[2m]))",
          "legendFormat": "Errores 5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sin datos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Porcentaje 5xx",
      "type": "stat",
      "description": "Sin tráfico o sin muestras suficientes: sin valor. No reemplaza datos ausentes por cero.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "devops-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(devops_http_requests_total{job=\"laravel\",status=~\"5..\"}[2m])) / (sum(rate(devops_http_requests_total{job=\"laravel\"}[2m])) > 0)",
          "legendFormat": "Porcentaje 5xx",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sin tráfico / sin muestras suficientes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Latencia media",
      "type": "stat",
      "description": "Sin tráfico o sin muestras suficientes: sin valor.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "devops-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(devops_http_request_duration_seconds_sum{job=\"laravel\"}[2m])) / (sum(rate(devops_http_request_duration_seconds_count{job=\"laravel\"}[2m])) > 0)",
          "legendFormat": "Latencia media",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin tráfico / sin muestras suficientes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Latencia p95",
      "type": "stat",
      "description": "p95 estimado a partir de buckets; sin observaciones: sin valor.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "devops-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le)(rate(devops_http_request_duration_seconds_bucket{job=\"laravel\"}[2m]))) and (sum(rate(devops_http_request_duration_seconds_count{job=\"laravel\"}[2m])) > 0)",
          "legendFormat": "Latencia p95",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin tráfico / sin muestras suficientes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Target Laravel",
      "type": "stat",
      "description": "1: scrape disponible; 0: fallo de recolección; ausente: sin datos.",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "devops-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"laravel\",instance=\"nginx:9091\"}",
          "legendFormat": "Target Laravel",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Alertas activas",
      "type": "timeseries",
      "description": "pending y firing; sin series implica ninguna alerta activa solo si Prometheus responde y el target existe.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "devops-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{job=\"laravel\",alertstate=~\"pending|firing\"}",
          "legendFormat": "{{alertname}} {{alertstate}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin alertas activas / verificar target",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
