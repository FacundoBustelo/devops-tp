APP_NAME=PrexChallenge
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
HTTP_PORT=8080
IMAGE_REPOSITORY=devops-tp
APP_VERSION=0.0.0-dev
VCS_REF=unknown

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_FORWARD_PORT=3306
DB_DATABASE=prex
DB_USERNAME=prex_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
GIPHY_API_KEY=
GIPHY_CONNECT_TIMEOUT=2
GIPHY_TIMEOUT=5

# Explicit proxy IP/CIDR allowlist; empty trusts none.
TRUSTED_PROXIES=

# Optional monitoring override only; generate a private value outside this repository.
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3000
